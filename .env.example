# BioResearch Assistant — Konfiguration Template
# Kopiere nach .env und passe an.
# NIEMALS .env in Git committen!

# ── App ──────────────────────────────────────────────
APP_VERSION=1.3.0
ENVIRONMENT=development
INSTITUTION=Meine Institution

# ── Datenbank ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bioresearch:DEIN_PASSWORT@localhost:5432/bioresearch
POSTGRES_PASSWORD=DEIN_SICHERES_PASSWORT

# ── Security ──────────────────────────────────────────
JWT_SECRET=MINDESTENS_64_ZEICHEN_ZUFAELLIG
PSEUDONYMIZATION_ENCRYPTION_KEY=64_HEX_ZEICHEN_ZUFAELLIG

# ── LLM (eines von beiden) ────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# ODER:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ── Isolation ─────────────────────────────────────────
ISOLATION_MODE=user
DEPSEUDO_ACCESS=owner

# ── Pseudonymisierung ────────────────────────────────
# Eigene Patienten-ID Muster (kommagetrennte Regex-Ausdrücke)
# Jede Klinik hat eigene Formate — hier anpassen!
# Beispiele:
#   Labor-ID:     L-\d{4}-\d{5}   → L-2024-98765
#   Patient-ID:   P-\d{4,8}       → P-12345
#   8-stellig:    \d{8}           → 12345678
#   Fallnummer:   F-\d{6}         → F-123456
# CUSTOM_PATIENT_ID_PATTERNS=

# ── OIDC (optional) ───────────────────────────────────
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=deine-client-id
# OIDC_CLIENT_SECRET=dein-client-secret

# ── Deployment ────────────────────────────────────────
DEPLOYMENT=local
DRS_DATA_DIR=/data/drs

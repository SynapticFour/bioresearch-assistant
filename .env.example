# BioResearch Assistant — Konfiguration Template
# Kopiere nach .env und passe an.
# NIEMALS .env in Git committen!

# ── Release-Version (Pflicht für ./install.sh --prod / --offline) ──
# GitHub-Release-Tag, z. B. v0.2.0 — kein stilles :latest
BRA_VERSION=v0.2.0

# Für Compose prod (docker-compose.prod.yml):
OLLAMA_IMAGE_TAG=0.5.13

# ── App ──────────────────────────────────────────────
ENVIRONMENT=development
INSTITUTION=Meine Institution

# ── Datenbank ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bioresearch:DEIN_PASSWORT@localhost:5432/bioresearch
POSTGRES_PASSWORD=DEIN_SICHERES_PASSWORT

# ── Security ──────────────────────────────────────────
JWT_SECRET=MINDESTENS_64_ZEICHEN_ZUFAELLIG
PSEUDONYMIZATION_ENCRYPTION_KEY=64_HEX_ZEICHEN_ZUFAELLIG

# ── LLM ───────────────────────────────────────────────
# auto = gültiger sk-ant-* Schlüssel → Anthropic Claude, sonst Ollama (wie /health).
# LLM_PROVIDER=auto
#
# Ollama (lokal oder Docker-Profil ollama):
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral  # Alternativen: llama3.2:3b, gemma3:4b, qwen2.5:7b, deepseek-r1:8b, gpt-oss:20b
#
# Anthropic Cloud:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI-kompatibel (lokal: SGLang/vLLM — siehe Docker-Profil inference in docker-compose.yml):
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=http://localhost:30000/v1
# OPENAI_MODEL=MiniMaxAI/MiniMax-M2
# OPENAI_API_KEY=
# Für geschützte HF-Modelle beim Inference-Container: HF_TOKEN (Compose-Umgebung oder Shell)

# ── Locus (curated on-prem RAG) ───────────────────────
# Lädt POST /api/v1/locus/rag und Status; Chunks in DB-Tab. locus_chunks
# (nach Alembic + ggf. scripts/seed_locus_demo.py)
# LOCUS_ENABLED=0

# ── MII-KDS / FHIR IG (Export) ─────────────────────────
# Pinned package — keep in sync with backend/app/interoperability/mii/ig_manifest.json
# MII_IG_PACKAGE_ID=de.medizininformatikinitiative.kerndatensatz.meta
# MII_IG_PACKAGE_VERSION=2026.0.0
# MII_KDS_RELEASE=2026
# Validator lokal: ./scripts/validate_fhir_bundle.sh

# ── Isolation ─────────────────────────────────────────
ISOLATION_MODE=user
DEPSEUDO_ACCESS=owner

# ── Pseudonymisierung ────────────────────────────────
# Eigene Patienten-ID Muster (kommagetrennte Regex-Ausdrücke)
# Jede Klinik hat eigene Formate — hier anpassen!
# Beispiele:
#   Labor-ID:     L-\d{4}-\d{5}   → L-2024-98765
#   Patient-ID:   P-\d{4,8}       → P-12345
#   8-stellig:    \d{8}           → 12345678
#   Fallnummer:   F-\d{6}         → F-123456
# CUSTOM_PATIENT_ID_PATTERNS=

# ── OIDC (optional) ───────────────────────────────────
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=deine-client-id
# OIDC_CLIENT_SECRET=dein-client-secret

# ── Solum subject bridge (optional, ADR-0003) ─────────
# SOLUM_BASE_URL=http://127.0.0.1:8787
# SOLUM_SIDECAR_TOKEN=solum-demo-local-token-not-for-production
# SOLUM_SUBJECT_BRIDGE_UPSERT=1

# ── Deployment ────────────────────────────────────────
# local | development | test  → unauthenticated dev user (FORBIDDEN in production)
# Uniklinik / prod: ENVIRONMENT=production and OIDC_ISSUER + OIDC_CLIENT_ID required.
# DEPLOYMENT=local with ENVIRONMENT=production will refuse to start.
DEPLOYMENT=local
DRS_DATA_DIR=/data/drs

# OIDC: redirect URI must be same-origin as the SPA (reverse proxy) so the
# httpOnly session cookie is stored for the browser origin.
# Local Vite: http://localhost:5173/api/v1/auth/callback
# Production: https://bra.uniklinik.example/api/v1/auth/callback
# OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
# FRONTEND_BASE_URL=http://localhost:5173

# ── GA4GH WES (optional) ───────────────────────────────
# Cap Nextflow/BLAST subprocess wall time (seconds). Omit = no limit (long HPC runs).
# WES_SUBPROCESS_TIMEOUT_SECONDS=86400
